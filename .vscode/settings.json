{
    "editor.renderWhitespace": "boundary",
    "editor.rulers": [
        80,
        100,
        120
    ],
    "editor.formatOnSave": true,
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.exclude": {
        "**/.git": true,
        "**/.venv": true,
        "**/.DS_Store": true,
        "**/.mypy_cache": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/__pycache__": true,
        "**/htmlcov": true
    },
    "terminal.integrated.defaultProfile.linux": "bash",

    // Copilot Chat Configuration
    "accessibility.signals.chatUserActionRequired": {
        "sound": "on",
        "announcement": "always"
    },
    "accessibility.signals.chatResponseReceived": {
        "sound": "on",
        "announcement": "always"
    },
    "github.copilot.chat.anthropic.tools.websearch.enabled": true,
    "github.copilot.chat.anthropic.tools.websearch.userLocation": {
        "country": "US",
        "timezone": "America/New_York"
    },
    "github.copilot.chat.anthropic.tools.websearch.maxUses": 5,
    "github.copilot.renameSuggestions.triggerAutomatically": true,

    // Claude Code Agent Configuration
    "github.copilot.chat.useProjectTemplates": true,
    "github.copilot.chat.codeGeneration.useInstructionFiles": true,
    "github.copilot.advanced": {
        "debug.overrideProxyUrl": "",
        "debug.testOverrideProxyUrl": "",
        "debug.filterLogCategories": []
    },
    "chat.useClaudeSkills": true,
    "github.copilot.chat.claudeCode.enabled": true,

    // Language Specific Settings
    "[json]": {
        "editor.formatOnSave": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    },

    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    },
    "markdown-toc.updateOnSave": false,
    "markdown-toc.depthFrom": 2,
    "markdown.extension.toc.levels": "2..6",

    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "never",
            "source.fixAll.ruff": "never"
        },
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    },
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,

    "[sql]": {
        "editor.formatOnSave": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    },

    "[yaml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    }
}
